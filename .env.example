# Database
DATABASE_URL=postgresql://router_user:router_password_dev@localhost:5432/soroban_router

# Redis
REDIS_URL=redis://:redis_password_dev@localhost:6379

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# Stellar Network Configuration
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Authentication & Security
API_KEY_SECRET=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-32-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_EXECUTE_MAX=10

# Routing Configuration
MAX_HOPS=3
DEFAULT_SLIPPAGE_TOLERANCE=0.01
QUOTE_VALIDITY_SECONDS=60
STALENESS_THRESHOLD_SECONDS=30

# Worker Configuration
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=5000
ANALYTICS_ENABLED=true
ANALYTICS_INTERVAL_MS=60000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# Soroban Contract IDs (Update after deployment)
ROUTER_CONTRACT_ID=
PATH_EXECUTOR_CONTRACT_ID=
SLIPPAGE_GUARD_CONTRACT_ID=

# Development Only - Remove in Production
DISABLE_AUTH=false
ENABLE_DEBUG_ROUTES=true
